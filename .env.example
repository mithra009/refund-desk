# Copy to .env and fill in. Every value below is a placeholder, not a working credential.

# --- model providers -------------------------------------------------------
GOOGLE_API_KEY=your-google-api-key-here                # Gemini: used by the LangGraph graph and the ADK risk service

# --- LangSmith (tracing, datasets, experiments, prompts) ---------------------
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=refund-desk

# --- database ----------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres-password
# Used outside compose; compose builds these from POSTGRES_PASSWORD:
DATABASE_URL=postgresql://postgres:change-me-postgres-password@localhost:5432/refund_desk
CHECKPOINT_DSN=postgresql://postgres:change-me-postgres-password@localhost:5432/refund_desk

# --- API auth (simulated) ----------------------------------------------------
# JSON map of bearer token -> customer id. Leave unset in dev to trust the X-Customer-Id header.
# REFUND_DESK_AUTH_TOKENS={"change-me-customer-token":"cus_demo_1"}
REVIEWER_TOKEN=change-me-reviewer-token

# --- models and thresholds (optional overrides) ---------------------------------
# fast=gemini-3.5-flash-lite, strong=gemini-3.1-flash-lite, risk=gemini-3.1-flash-lite-preview: one model per
# role because free-tier quota (15 req/min) is counted per model. Override per tier, e.g.:
# REFUND_DESK_REQUESTS_PER_MINUTE=12   # client-side throttle per model id; raise it on a paid plan
# REFUND_DESK_FAST=google_genai:gemini-3.5-flash-lite
# REFUND_DESK_STRONG=google_genai:<a stronger Gemini model>
# REFUND_DESK_CRITIC_MODEL=google_genai:<another Gemini model>
# REFUND_DESK_PROMPT_VERSION=local                          # or a LangSmith prompt commit/tag
# RISK_MODEL=gemini-3.1-flash-lite-preview                 # model id for the ADK agents
